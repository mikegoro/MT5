   _0745 = 465,     // 07:45
   _0800 = 480,     // 08:00
   _0815 = 495,     // 08:15
   _0830 = 510,     // 08:30
   _0845 = 525,     // 08:45
   _0900 = 540,     // 09:00
   _0915 = 555,     // 09:15
   _0930 = 570,     // 09:30
   _0945 = 585,     // 09:45
   _1000 = 600,     // 10:00
   _1015 = 615,     // 10:15
   _1030 = 630,     // 10:30
   _1045 = 645,     // 10:45
   _1100 = 660,     // 11:00
   _1115 = 675,     // 11:15
   _1130 = 690,     // 11:30
   _1145 = 705,     // 11:45
   _1200 = 720,     // 12:00
   _1215 = 735,     // 12:15
   _1230 = 750,     // 12:30
   _1245 = 765,     // 12:45
   _1300 = 780,     // 13:00
   _1315 = 795,     // 13:15
   _1330 = 810,     // 13:30
   _1345 = 825,     // 13:45
   _1400 = 840,     // 14:00
   _1415 = 855,     // 14:15
   _1430 = 870,     // 14:30
   _1445 = 885,     // 14:45
   _1500 = 900,     // 15:00
   _1515 = 915,     // 15:15
   _1530 = 930,     // 15:30
   _1545 = 945,     // 15:45
   _1600 = 960,     // 16:00
   _1615 = 975,     // 16:15
   _1630 = 990,     // 16:30
   _1645 = 1005,    // 16:45
   _1700 = 1020,    // 17:00
   _1715 = 1035,    // 17:15
   _1730 = 1050,    // 17:30
   _1745 = 1065,    // 17:45
   _1800 = 1080,    // 18:00
   _1815 = 1095,    // 18:15
   _1830 = 1110,    // 18:30
   _1845 = 1125,    // 18:45
   _1900 = 1140,    // 19:00
   _1915 = 1155,    // 19:15
   _1930 = 1170,    // 19:30
   _1945 = 1185,    // 19:45
   _2000 = 1200,    // 20:00
   _2015 = 1215,    // 20:15
   _2030 = 1230,    // 20:30
   _2045 = 1245,    // 20:45
   _2100 = 1260,    // 21:00
   _2115 = 1275,    // 21:15
   _2130 = 1290,    // 21:30
   _2145 = 1305,    // 21:45
   _2200 = 1320,    // 22:00
   _2215 = 1335,    // 22:15
   _2230 = 1350,    // 22:30
   _2245 = 1365,    // 22:45
   _2300 = 1380,    // 23:00
   _2315 = 1395,    // 23:15
   _2330 = 1410,    // 23:30
